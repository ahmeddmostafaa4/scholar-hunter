# Copy this file to .env and fill in your keys.
# NEVER commit the real .env — it is git-ignored.

# --- Model access: pick ONE of the two ---

# 1. iHQ LiteLLM proxy key (the shared server — this is the usual setup).
#    Keys come from litellm-api-keys.xlsx and carry a $3 lifetime budget.
#    Check what is left:
#      curl https://litellm.i-hq.tech/key/info -H "Authorization: Bearer sk-..."
LITELLM_API_KEY=

# 2. Or a direct Anthropic key, if you have one (starts with sk-ant-).
#    Leave blank when using the proxy above.
ANTHROPIC_API_KEY=

# --- Web search (required either way) ---

# Tavily web search API key (https://tavily.com — free tier available)
TAVILY_API_KEY=

# --- Optional ---

# GIU portal/CMS credentials, used ONLY by the optional giu_tools module to
# auto-load your transcript (GPA + completed courses). If absent, the agent
# falls back to typed/uploaded courses.
GIU_USERNAME=
GIU_PASSWORD=

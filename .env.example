# Copy this file to .env and fill in your keys.
# NEVER commit the real .env — it is git-ignored.

# Anthropic Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Tavily web search API key (https://tavily.com — free tier available)
TAVILY_API_KEY=

# Optional: GIU portal/CMS credentials, used ONLY by the optional
# giu_tools module to auto-load your transcript (GPA + completed courses).
# If absent, the agent falls back to typed/uploaded courses.
GIU_USERNAME=
GIU_PASSWORD=
